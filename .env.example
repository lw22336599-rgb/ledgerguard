# Public read-only Arc Testnet RPC endpoints, comma separated.
ARC_TESTNET_RPC_URLS=https://rpc.testnet.arc.network,https://rpc.blockdaemon.testnet.arc.network,https://rpc.drpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network

# Optional. Enables x402 protection only after a public payout address is supplied.
# Never put a private key or seed phrase here.
PUBLIC_BASE_URL=http://localhost:3000
SELLER_ADDRESS=
X402_ENABLED=false
X402_PRICE_MICRO_USDC=1000
RATE_LIMIT_PER_MINUTE=60

# Optional CDP Bazaar candidate. This is Base Sepolia test USDC only.
# Keep false until CDP credentials are stored as encrypted deployment secrets.
BASE_SEPOLIA_X402_ENABLED=false
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional Base Mainnet x402 canary. This uses real USDC. Keep disabled until
# the exact public fingerprint is reviewed and action-time approval is given.
BASE_MAINNET_X402_ENABLED=false
BASE_MAINNET_PRICE_MICRO_USDC=1000
BASE_MAINNET_CONFIG_APPROVED_SHA256=
BASE_MAINNET_RELEASE_APPROVAL=

# Developer self-service requires a shared Redis-compatible REST store.
# The API fails closed when either credential is absent. Never expose the token
# to browser code or commit it to source control.
DEVELOPER_SELF_SERVICE_ENABLED=false
DEVELOPER_MAX_TENANTS=100
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional HTTPS endpoint for a sanitized JSON notification after a successful
# testnet payment. Notification failure never blocks paid resource delivery.
OPERATIONS_WEBHOOK_URL=

# Arc Mainnet remains disabled unless every official value is present and the
# SHA-256 fingerprint plus the separate release approval are supplied.
ARC_MAINNET_ENABLED=false
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_RPC_URL=
ARC_MAINNET_USDC_ADDRESS=
ARC_MAINNET_EXPLORER_URL=
ARC_MAINNET_CONFIG_APPROVED_SHA256=
ARC_MAINNET_RELEASE_APPROVAL=

# Optional Arc chain 5042 read-only shadow. Supply a full read-only RPC and an
# independent network-status observer. This never activates mainnet.
ARC_MAINNET_SHADOW_ENABLED=false
ARC_MAINNET_SHADOW_RPC_URLS=
ARC_MAINNET_SHADOW_MIN_HEALTHY_RPCS=1
ARC_MAINNET_SHADOW_OBSERVER_URLS=
ARC_MAINNET_SHADOW_MIN_HEALTHY_OBSERVERS=1
ARC_MAINNET_SHADOW_MAX_BLOCK_LAG=20
ARC_MAINNET_SHADOW_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_MAINNET_SHADOW_GATEWAY_MINTER_ADDRESS=0x2222222d7164433c4C09B0b0D809a9b52C04C205

PORT=3000
