{
  "name": "ledgerguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protocol-neutral, non-custodial transaction intent control and evidence layer.",
  "exports": {
    "./sdk": {
      "types": "./dist/src/sdk/index.d.ts",
      "import": "./dist/src/sdk/index.js"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "verify:brand": "node scripts/verify-brand-local.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "compress:marketing": "node scripts/compress-marketing.mjs",
    "build": "npm run build:brand && npm run build:browser && tsc -p tsconfig.json && npm run build:sdk",
    "build:sdk": "npm run build --prefix packages/sdk",
    "test:sdk-pack": "npm run test:pack-install --prefix packages/sdk",
    "conformance": "vitest run tests/conformance-profile.test.ts tests/telemetry.test.ts",
    "verify:release": "npm run typecheck && npm run test:coverage && npm run conformance && npm run build && npm run test:sdk-pack && npm audit --omit=dev",
    "publish:sdk": "node scripts/publish-sdk.mjs",
    "publish:sdk:dry-run": "node scripts/publish-sdk.mjs --dry-run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:integrations": "node scripts/local-integration-smoke.mjs",
    "audit:ui:local": "node scripts/local-ui-audit.mjs",
    "audit:ui:production": "node scripts/audit-ui-modules.mjs",
    "audit:production": "node scripts/fetch-audit-production.mjs",
    "tenant:govern": "node scripts/tenant-govern.mjs",
    "x402:buyer:init": "node scripts/x402-buyer.mjs init",
    "x402:buyer": "node --env-file-if-exists=.env.x402-buyer.local scripts/x402-buyer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/extensions": "^2.20.0",
    "@x402/hono": "^2.20.0",
    "hono": "^4.10.4",
    "qrcode": "^1.5.4",
    "viem": "^2.38.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ledgerguard1/sdk": "file:packages/sdk",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "@x402/fetch": "^2.20.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "overrides": {
    "axios": "^1.18.0"
  }
}
