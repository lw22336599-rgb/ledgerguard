{
  "name": "@ledgerguard1/adapter-kit",
  "version": "0.1.0",
  "description": "Protocol-neutral contracts for isolated LedgerGuard extensions.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "test:pack-install": "node scripts/test-pack-install.mjs"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lw22336599-rgb/ledgerguard.git",
    "directory": "packages/adapter-kit"
  }
}
