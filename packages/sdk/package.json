{
  "name": "@ledgerguard1/sdk",
  "version": "0.1.1",
  "description": "LedgerGuard stablecoin payment safety SDK — preflight before signing, evidence after settlement.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pack:check": "npm pack --dry-run",
    "test:pack-install": "node scripts/test-pack-install.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ledgerguard",
    "usdc",
    "preflight",
    "arc",
    "x402",
    "payment-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lw22336599-rgb/ledgerguard.git",
    "directory": "packages/sdk"
  }
}
